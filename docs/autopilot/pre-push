#!/bin/sh
# Cheatproof pre-push hook. Install from the repo root (works in a worktree too):
#   cp docs/autopilot/pre-push "$(git rev-parse --git-path hooks)/pre-push"
# Git runs it with stdin lines "<local ref> <local sha> <remote ref> <remote sha>" and every line is checked.
# A push to refs/heads/main may change only docs/autopilot/QUEUE.md, docs/autopilot/LOG.md and STATUS.md.
# It must fast-forward main; deleting main, or creating main on the remote (all-zero remote sha), is rejected.
# Other refs are allowed. `gh pr merge` creates its merge commit on GitHub, not in a push, so this hook
# does not see it. Exit 1 rejects the push. Needs only git and a POSIX sh.
set -eu

die() {
	echo "pre-push: $1" >&2
	exit 1
}

# An all-zero sha means the ref does not exist on that side of the push.
is_zero() {
	case "$1" in
	*[!0]*) return 1 ;;
	*) return 0 ;;
	esac
}

# The last line is checked even when git omits its final newline.
while read -r lref lsha rref rsha || [ -n "${rsha-}" ]; do
	[ "$rref" = refs/heads/main ] || continue
	[ -n "$lsha" ] && [ -n "$rsha" ] || die "malformed push line for main"
	is_zero "$lsha" && die "deleting main is not allowed"
	is_zero "$rsha" && die "creating main on the remote is not allowed"
	# merge-base --is-ancestor exits 0 for an ancestor, 1 when not, and more on error (unknown sha, no repo).
	rc=0
	git merge-base --is-ancestor "$rsha" "$lsha" || rc=$?
	case "$rc" in
	0) ;;
	1) die "non-fast-forward push to main" ;;
	*) die "cannot check that the push to main fast-forwards; fetch the remote first" ;;
	esac
	# --no-renames lists both sides of a rename, so a move from a disallowed path is caught. The submodule
	# option overrides any diff.ignoreSubmodules setting, so a gitlink (submodule pointer) change is listed too.
	if ! changed=$(git --no-pager diff --no-renames --ignore-submodules=none --name-only "$rsha" "$lsha" --); then
		die "cannot read the pushed range $rsha..$lsha; fetch the remote first"
	fi
	# Whole-line match on each path: a name with spaces or a suffix cannot pass as an allowed name.
	# grep exits 1 when every path is allowed; anything above 1 is an error, and the push is refused.
	rc=0
	bad=$(printf '%s\n' "$changed" | grep -vxF -e docs/autopilot/QUEUE.md -e docs/autopilot/LOG.md -e STATUS.md) ||
		rc=$?
	[ "$rc" -le 1 ] || die "cannot check the changed paths"
	if [ -n "$bad" ]; then
		echo "pre-push: a push to main may change only docs/autopilot/QUEUE.md, docs/autopilot/LOG.md and STATUS.md." >&2
		echo "pre-push: other paths changed:" >&2
		printf '%s\n' "$bad" >&2
		exit 1
	fi
done
exit 0
