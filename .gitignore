# Secrets and local-only files: never committed
.env
.env.*
!.env.example
.claude/settings.local.json
LEARNING.md
# Runtime state (spend ledger, run traces)
runs/
# Raw attacker step args: never committed unsanitized
results/traces/
# Any folder named traces (T46): raw attacker traces and diffs, wherever a run keeps them
**/traces/
results/reports/
# Local site build (cli site default output; CI builds it, never commits it)
results/site/
# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
# Raw diffs and old certificate copies: never committed (tracked digests are results/diffs/*.diff.json)
results/certificates/*.old
results/diffs/*.before.diff
results/diffs/*.after.diff
results/diffs/*.diff
