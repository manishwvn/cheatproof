# Copy to .env and fill in. Never commit .env, never paste keys in chat.
NEBIUS_API_KEY=
NEBIUS_PROJECT_ID=
NEBIUS_AI_PROJECT=
TAVILY_API_KEY=
GITHUB_TOKEN=
# Model IDs: VERIFY with scripts/smoke.py once the key works.
ATTACKER_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
DEV_ATTACKER_MODEL=nvidia/Nemotron-3-Super-120b-a12b
CLASSIFIER_MODEL=nvidia/Nemotron-3-Nano-30B-A3B
# Executor (docs/adr/0002-execution-model.md): docker or sandbox.
EXECUTOR=docker
DOCKER_IMAGE_CAP=6
MIN_FREE_DISK_GB=10
TAVILY_CALL_CAP=200
# Hard spend caps. SPEND_CAP_USD is the one total cap ($20 of about $25 credits); only the owner changes it.
SPEND_CAP_USD=20
DAILY_CAP_USD=4
SANDBOX_RUN_CAP=250
# VERIFY: per-run sandbox price is undocumented; this guess counts toward SPEND_CAP_USD.
SANDBOX_RUN_USD=0.05
MAX_OUTPUT_TOKENS=4096
SPEND_LEDGER=~/.cheatproof-autopilot/ledger.json
# Per-1M-token [input, output] USD prices, e.g. {"nvidia/...": [0.06, 0.24]}. Unknown models use $3/$10.
MODEL_PRICES_JSON={}
