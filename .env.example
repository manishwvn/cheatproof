# Copy to .env and fill in. Never commit .env, never paste keys in chat.
NEBIUS_API_KEY=
NEBIUS_PROJECT_ID=
NEBIUS_AI_PROJECT=
TAVILY_API_KEY=
GITHUB_TOKEN=
# Model IDs: VERIFY with scripts/smoke.py once the key works.
CANARY_MODEL=nvidia/Nemotron-3-Super-120b-a12b
VERDICT_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
TRIAGE_MODEL=nvidia/Nemotron-3-Nano-30B-A3B
# Hard spend caps. Keep SPEND_CAP_USD well under the free credits on the account.
SPEND_CAP_USD=30
DAILY_CAP_USD=4
SANDBOX_RUN_CAP=250
# VERIFY: per-run sandbox price is undocumented; this guess counts toward SPEND_CAP_USD.
SANDBOX_RUN_USD=0.05
MAX_OUTPUT_TOKENS=4096
SPEND_LEDGER=runs/ledger.json
# Per-1M-token [input, output] USD prices, e.g. {"nvidia/...": [0.06, 0.24]}. Unknown models use $3/$10.
MODEL_PRICES_JSON={}
