# Copy to .env and fill in. Never commit .env, never paste keys in chat.
NEBIUS_API_KEY=
NEBIUS_PROJECT_ID=
NEBIUS_AI_PROJECT=
TAVILY_API_KEY=
GITHUB_TOKEN=
# Model IDs and per-1M [input, output] USD prices, confirmed from GET /v1/models?verbose=true on 2026-10-18:
#   Nano      nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B   0.06 / 0.24
#   Lightning nvidia/Nemotron-3_5-Lightning           0.06 / 0.24
#   Super     nvidia/nemotron-3-super-120b-a12b       0.30 / 0.90
#   Ultra     nvidia/Nemotron-3-Ultra-550b-a55b       1.00 / 3.00
# Nano reasons before answering: 64 output tokens returned no content, so give it room (VERIFY in T04).
# Ultra is for a few hero runs only, passed by explicit --attacker-model.
ATTACKER_MODEL=nvidia/nemotron-3-super-120b-a12b
DEV_ATTACKER_MODEL=nvidia/nemotron-3-super-120b-a12b
CLASSIFIER_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# Executor (docs/adr/0002-execution-model.md): docker or sandbox.
EXECUTOR=sandbox
# WARNING: setting SANDBOX_NETWORK_TRUSTED=1 skips the network-off probe and weakens containment. Never set it.
# SANDBOX_NETWORK_TRUSTED=
DOCKER_IMAGE_CAP=6
MIN_FREE_DISK_GB=10
TAVILY_CALL_CAP=200
# Hard spend caps. The project cap is SPEND_CAP_USD=20 and DAILY_CAP_USD=4; only the owner changes them. On a fresh
# account holding only the $1 trial, use 0.8 for both until the promo credit shows.
SPEND_CAP_USD=20
DAILY_CAP_USD=4
# Real-spend cap: TOTAL real Token Factory spend (trial + hackathon promo credit) may not pass this. Default 10, and 10 is
# a hard ceiling in code: a value above 10, zero, negative or invalid is refused, never turned into a higher cap. The
# account balance must never go negative (a negative balance charges the card). Only a lower value changes anything.
# REAL_SPEND_CAP_USD=10
# Old trial cap, now only an extra, stricter cap if you set it (unset means off). It never raises REAL_SPEND_CAP_USD.
# TRIAL_CREDIT_CAP_USD=0.74
SANDBOX_RUN_CAP=250
# Sandbox runs count against SANDBOX_RUN_CAP and book no Token Factory money. Each reported Sandboxes cost is logged in the
# ledger; the budget halts once the logged sum passes SANDBOX_COST_CAP_USD (code default 0.50; an invalid value uses 0.50).
# Intended value: 5, set by the orchestrator under the owner's $10 approval (2026-10-23). Estimate counter; trips if Sandboxes
# billing ever starts (not billed as of 2026-10-23).
# SANDBOX_COST_CAP_USD=5
# SANDBOX_RUN_USD is parsed but not charged.
# Local Docker runs are free; this only bounds how many run.
LOCAL_RUN_CAP=2000
# VERIFY: per-run sandbox price is undocumented; parsed, not charged in beta.
SANDBOX_RUN_USD=0.05
MAX_OUTPUT_TOKENS=4096
SPEND_LEDGER=~/.cheatproof-autopilot/ledger.json
# Per-1M-token [input, output] USD prices, e.g. {"nvidia/...": [0.06, 0.24]}. Unknown models use $3/$10.
MODEL_PRICES_JSON={"nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B":[0.06,0.24],"nvidia/Nemotron-3_5-Lightning":[0.06,0.24],"nvidia/nemotron-3-super-120b-a12b":[0.3,0.9],"nvidia/Nemotron-3-Ultra-550b-a55b":[1.0,3.0]}
# T02 executor guards (cheatproof/executor.py): before a NEW image pull, free disk on / must be >= MIN_FREE_DISK_GB
# and local image count < DOCKER_IMAGE_CAP. Either refuses; nothing is deleted. Already-local images skip both.
# Disk guard (2026-10-19): a NEW pull also needs MIN_FREE_DISK_GB left after an estimated PULL_ESTIMATE_GB, and at most
# TASK_IMAGE_CAP swebench/* images may be local. The batch removes each finished task's swebench/* image (never others).
TASK_IMAGE_CAP=2
PULL_ESTIMATE_GB=4.5
